{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "paths": {
      "@library/*": ["./tests/library/*"]
    },

    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },

  "include": [
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}